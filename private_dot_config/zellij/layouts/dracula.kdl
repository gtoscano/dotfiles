// Dracula layout: zjstatus on top, built-in status-bar (shortcut hints) at the bottom
layout {
    default_tab_template {
        pane size=1 borderless=true {
        plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
            format_left   "{mode} #[fg=#bd93f9,bold] {session} "
            format_center "{tabs}"
            format_right  "{datetime}"
            format_space  ""
            hide_frame_for_single_pane "false"

            mode_normal        "#[bg=#50fa7b,fg=#282a36,bold] NORMAL "
            mode_locked        "#[bg=#6272a4,fg=#f8f8f2,bold] LOCKED "
            mode_pane          "#[bg=#ff79c6,fg=#282a36,bold] PANE "
            mode_tab           "#[bg=#8be9fd,fg=#282a36,bold] TAB "
            mode_resize        "#[bg=#ffb86c,fg=#282a36,bold] RESIZE "
            mode_move          "#[bg=#ff5555,fg=#282a36,bold] MOVE "
            mode_scroll        "#[bg=#f1fa8c,fg=#282a36,bold] SCROLL "
            mode_search        "#[bg=#f1fa8c,fg=#282a36,bold] SEARCH "
            mode_enter_search  "#[bg=#f1fa8c,fg=#282a36,bold] SEARCH "
            mode_session       "#[bg=#bd93f9,fg=#282a36,bold] SESSION "
            mode_rename_tab    "#[bg=#8be9fd,fg=#282a36,bold] RENAME TAB "
            mode_rename_pane   "#[bg=#ff79c6,fg=#282a36,bold] RENAME PANE "
            mode_prompt        "#[bg=#bd93f9,fg=#282a36,bold] PROMPT "
            mode_tmux          "#[bg=#ffb86c,fg=#282a36,bold] TMUX "

            tab_normal              "#[fg=#6272a4] {index}:{name} "
            tab_normal_fullscreen   "#[fg=#6272a4] {index}:{name} [] "
            tab_active              "#[fg=#f8f8f2,bold] {index}:{name} "
            tab_active_fullscreen   "#[fg=#f8f8f2,bold] {index}:{name} [] "

            datetime          "#[fg=#6272a4] {format} "
            datetime_format   "%a %d %b  %H:%M"
            datetime_timezone "America/New_York"
        }
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }
}
