#theme = catppuccin-mocha
theme = Dracula
# theme = GruvboxDark
# font-family = DejaVuSansMono Nerd Font Mono
font-family = Inconsolata LGC Nerd Font Propo 
font-size = 16
background-opacity = 1 
gtk-titlebar = false
mouse-hide-while-typing = true
window-decoration = false


# Free Ctrl+Alt+arrows for Zellij (pane focus); Zellij manages the splits
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
